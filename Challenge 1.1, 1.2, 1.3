# Dictionaries
# Challenge 1.1, 1.2, and 1.3

states = {
"Oregon": "OR",
"Florida": "FL",
"California": "CA",
"New York": "NY",
"Michigan": "MI"
}
states["WY"] = "Wyoming"
more_states = {
"Alabama": "AL",
"Alaska": "AK"
}

print(states)

states.update(more_states)

print(states)

